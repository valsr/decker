{
  "format": 3,
  "id": "com.decker.acttest",
  "name": "Actions Test",
  "version": "1.0.0",
  "author": "Decker",
  "description": "Test-only plugin that runs bound actions.",
  "decker": ">=0.7",
  "runtime": { "type": "python", "entry": "plugin.py" },
  "contributes": {
    "cards": [
      {
        "id": "com.decker.acttest.tile",
        "name": "Tile",
        "tooltip": "A card whose gestures run plugin actions",
        "bindings": {
          "press": { "action": "com.decker.acttest.mark", "args": { "tag": "p" } },
          "long_press": { "action": "com.decker.acttest.mark", "args": { "tag": "l" } }
        }
      }
    ],
    "actions": [
      {
        "id": "com.decker.acttest.mark",
        "name": "Mark",
        "tooltip": "Appends a tag to marks.log",
        "scope": "plugin",
        "settings": [
          { "key": "tag", "type": "text", "label": "Tag", "required": true, "pattern": "[a-z]+" }
        ]
      },
      {
        "id": "com.decker.acttest.public",
        "name": "Public",
        "tooltip": "Writes its arguments to public.log",
        "scope": "global",
        "settings": [
          { "key": "page", "type": "page", "label": "Page" }
        ]
      },
      {
        "id": "com.decker.acttest.nav",
        "name": "Navigate",
        "tooltip": "Switches the calling device to a page",
        "scope": "global",
        "settings": [
          { "key": "page", "type": "page", "label": "Page" }
        ]
      },
      {
        "id": "com.decker.acttest.double",
        "name": "Double",
        "tooltip": "Returns twice its n",
        "scope": "plugin",
        "settings": [
          { "key": "n", "type": "int", "label": "N", "default": 0 }
        ]
      },
      {
        "id": "com.decker.acttest.chain",
        "name": "Chain",
        "tooltip": "Calls double and logs the value",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.recurse",
        "name": "Recurse",
        "tooltip": "Calls itself with n + 1 until refused",
        "scope": "plugin",
        "settings": [
          { "key": "n", "type": "int", "label": "N", "default": 0 }
        ]
      },
      {
        "id": "com.decker.acttest.paint",
        "name": "Paint",
        "tooltip": "Paints a blue square on the calling card",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.probe",
        "name": "Probe",
        "tooltip": "Reports which modules the plugin process can import",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.relay",
        "name": "Relay",
        "tooltip": "Calls public for page p1 without naming a device",
        "scope": "global",
        "settings": []
      }
    ]
  }
}
