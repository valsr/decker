{
  "format": 3,
  "id": "com.decker.acttest",
  "name": "Actions Test",
  "version": "1.0.0",
  "author": "Decker",
  "description": "Test-only plugin that runs bound actions.",
  "decker": ">=0.7",
  "runtime": {
    "type": "python",
    "entry": "plugin.py"
  },
  "contributes": {
    "cards": [
      {
        "id": "com.decker.acttest.iconcard",
        "name": "Icon Card",
        "tooltip": "A card that shows a built-in Font Awesome icon",
        "icon": "fas:play"
      },
      {
        "id": "com.decker.acttest.tile",
        "name": "Tile",
        "tooltip": "A card whose gestures run plugin actions",
        "bindings": {
          "press": {
            "action": "com.decker.acttest.mark",
            "args": {
              "tag": "p"
            }
          },
          "long_press": {
            "action": "com.decker.acttest.mark",
            "args": {
              "tag": "l"
            }
          }
        }
      }
    ],
    "actions": [
      {
        "id": "com.decker.acttest.mark",
        "name": "Mark",
        "tooltip": "Appends a tag to marks.log",
        "scope": "plugin",
        "settings": [
          {
            "key": "tag",
            "type": "text",
            "label": "Tag",
            "required": true,
            "pattern": "[a-z]+"
          }
        ]
      },
      {
        "id": "com.decker.acttest.public",
        "name": "Public",
        "tooltip": "Writes its arguments to public.log",
        "scope": "global",
        "settings": [
          {
            "key": "page",
            "type": "page",
            "label": "Page"
          }
        ]
      },
      {
        "id": "com.decker.acttest.nav",
        "name": "Navigate",
        "tooltip": "Switches the calling device to a page",
        "scope": "global",
        "settings": [
          {
            "key": "page",
            "type": "page",
            "label": "Page"
          }
        ]
      },
      {
        "id": "com.decker.acttest.double",
        "name": "Double",
        "tooltip": "Returns twice its n",
        "scope": "plugin",
        "settings": [
          {
            "key": "n",
            "type": "int",
            "label": "N",
            "default": 0
          }
        ]
      },
      {
        "id": "com.decker.acttest.chain",
        "name": "Chain",
        "tooltip": "Calls double and logs the value",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.recurse",
        "name": "Recurse",
        "tooltip": "Calls itself with n + 1 until refused",
        "scope": "plugin",
        "settings": [
          {
            "key": "n",
            "type": "int",
            "label": "N",
            "default": 0
          }
        ]
      },
      {
        "id": "com.decker.acttest.paint",
        "name": "Paint",
        "tooltip": "Paints a blue square on the calling card",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.probe",
        "name": "Probe",
        "tooltip": "Reports which modules the plugin process can import",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.relay",
        "name": "Relay",
        "tooltip": "Calls public for page p1 without naming a device",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.step",
        "name": "Step",
        "tooltip": "Appends n to steps.log; fails when asked",
        "scope": "global",
        "settings": [
          {
            "key": "n",
            "type": "int",
            "label": "N",
            "default": 0
          },
          {
            "key": "fail",
            "type": "bool",
            "label": "Fail",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.acttest.next",
        "name": "Next page",
        "tooltip": "Switches the call's device to the next page",
        "scope": "global",
        "settings": []
      },
      {
        "id": "com.decker.acttest.snooze",
        "name": "Snooze",
        "tooltip": "Sleeps for five seconds",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.capped",
        "name": "Capped",
        "tooltip": "Calls snooze under a one second limit and logs how it went",
        "scope": "global",
        "timeout": 1,
        "settings": []
      },
      {
        "id": "com.decker.acttest.setvar",
        "name": "Set variable",
        "tooltip": "Sets a card variable",
        "scope": "plugin",
        "variables": [
          {
            "name": "pid",
            "description": "A number"
          },
          {
            "name": "other",
            "description": "Another"
          }
        ],
        "settings": [
          {
            "key": "name",
            "type": "text",
            "label": "Name",
            "default": "pid"
          },
          {
            "key": "value",
            "type": "text",
            "label": "Value",
            "default": "1"
          },
          {
            "key": "big",
            "type": "bool",
            "label": "Big",
            "default": false
          },
          {
            "key": "nan",
            "type": "bool",
            "label": "NaN",
            "default": false
          }
        ]
      },
      {
        "id": "com.decker.acttest.echo",
        "name": "Echo",
        "tooltip": "Writes its text to echo.log",
        "scope": "plugin",
        "settings": [
          {
            "key": "text",
            "type": "text",
            "label": "Text",
            "default": "",
            "template": true
          }
        ]
      },
      {
        "id": "com.decker.acttest.boom",
        "name": "Boom",
        "tooltip": "Always fails",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.slots",
        "name": "Slots",
        "tooltip": "Calls children with slots",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.inner",
        "name": "Inner",
        "tooltip": "Calls setvar with a slot",
        "scope": "plugin",
        "settings": []
      },
      {
        "id": "com.decker.acttest.lingering",
        "name": "Lingering",
        "tooltip": "Waits for a go file, then echoes a reference",
        "scope": "plugin",
        "settings": [],
        "timeout": 30,
        "variables": [
          {
            "name": "pid",
            "description": "A number"
          }
        ]
      },
      {
        "id": "com.decker.acttest.flood",
        "name": "Flood",
        "tooltip": "Calls echo with 34 slots",
        "scope": "plugin",
        "settings": [],
        "variables": [
          {
            "name": "pid",
            "description": "A number"
          }
        ]
      }
    ]
  }
}
