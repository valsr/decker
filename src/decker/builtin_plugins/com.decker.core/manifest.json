{
  "format": 3,
  "id": "com.decker.core",
  "name": "Core",
  "version": "0.7.1",
  "author": "Decker",
  "description": "The actions Decker ships.",
  "icon": "icons/blank",
  "decker": ">=0.7",
  "runtime": { "type": "python", "entry": "plugin.py" },
  "category": "Utilities",
  "contributes": {
    "cards": [],
    "actions": [
      {
        "id": "com.decker.core.nothing",
        "name": "Do Nothing",
        "tooltip": "Does nothing",
        "scope": "global",
        "icon": "icons/nothing"
      },
      {
        "id": "com.decker.core.httprequest",
        "name": "HTTP Request",
        "tooltip": "Sends an HTTP request",
        "scope": "global",
        "icon": "icons/blank",
        "returns": "{\"status\": int, \"body\": str}: the HTTP status and up to 512 KiB of the response body",
        "settings": [
          {
            "key": "method",
            "type": "choice",
            "label": "Method",
            "options": [
              { "label": "GET", "value": "GET" },
              { "label": "POST", "value": "POST" },
              { "label": "PUT", "value": "PUT" },
              { "label": "PATCH", "value": "PATCH" },
              { "label": "DELETE", "value": "DELETE" }
            ]
          },
          { "key": "url", "type": "text", "label": "URL", "placeholder": "https://example.com/hook" },
          { "key": "body", "type": "text", "label": "Body", "multiline": true },
          { "key": "content_type", "type": "text", "label": "Content type", "placeholder": "application/json" },
          { "key": "timeout", "type": "int", "label": "Timeout (seconds)", "default": 10, "min": 1, "max": 120 }
        ]
      }
    ]
  }
}
