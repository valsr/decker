{
  "format": 3,
  "id": "{{plugin_id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "author": "Your Name",
  "description": "A Decker plugin.",
  "decker": ">=0.7",
  "runtime": {
    "type": "python",
    "entry": "plugin.py"
  },
  "contributes": {
    "cards": [
      {
        "id": "{{card_id}}",
        "name": "{{name}}",
        "tooltip": "Press to say hello",
        "icon": "icons/card",
        "states": [{ "image": "icons/card" }],
        "bindings": { "press": { "action": "{{plugin_id}}.hello" } }
      }
    ],
    "actions": [
      {
        "id": "{{plugin_id}}.hello",
        "name": "Say hello",
        "tooltip": "Logs a greeting",
        "scope": "plugin",
        "icon": "icons/card"
      }
    ]
  }
}
