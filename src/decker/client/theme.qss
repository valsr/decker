/* ── Decker application stylesheet template ──
 * Rendered by decker.client.themes: each dollar-prefixed placeholder is replaced with a theme palette colour.
 */

/* ── Base ── */
QWidget {
    color: $text;
}

QWidget:disabled {
    color: $text_disabled;
}

QMainWindow,
QDialog {
    background-color: $window;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: $surface;
    border: 1px solid $border;
    color: $text;
    padding: 4px 6px;
}

/* ── Text inputs ── */
QLineEdit,
QSpinBox,
QComboBox {
    background-color: $base;
    border: 1px solid $border;
    border-radius: 4px;
    color: $text;
    padding: 3px 6px;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: $accent_line;
}

QLineEdit[invalid="true"] {
    border-color: $error;
}

QLineEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: $surface;
    color: $text_disabled;
}

QComboBox QAbstractItemView {
    background-color: $base;
    border: 1px solid $border;
    color: $text;
    outline: none;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

/* ── Buttons ── */
QPushButton {
    background-color: $raised;
    border: 1px solid $border;
    border-radius: 4px;
    color: $text;
    padding: 4px 14px;
}

QPushButton:hover {
    background-color: $hover;
}

QPushButton:pressed {
    background-color: $pressed;
}

QPushButton:focus {
    border-color: $accent_line;
}

KeyButtonWidget[selected="true"] {
    border: 2px solid $accent_line;
}

QPushButton[dirty="true"] {
    background-color: $accent;
    border-color: $accent_line;
    color: $accent_text;
}

QPushButton[dirty="true"]:hover {
    background-color: $accent_line;
}

QPushButton[dirty="true"]:pressed {
    background-color: $pressed;
    color: $text;
}

QPushButton:disabled {
    background-color: $surface;
    color: $text_disabled;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: $text;
    padding: 3px 6px;
}

QToolButton:hover {
    background-color: $hover;
}

/* The hover play button on a key: a small disc, so its glyph is not squeezed by the generic tool-button padding. */
QToolButton#keyRunButton {
    background-color: $raised;
    border: none;
    border-radius: 15px;
    padding: 0;
}

QToolButton#keyRunButton:hover {
    background-color: $hover;
}

/* The hover delete button on a key: its red disc is the icon itself, so no background of its own. */
QToolButton#keyDeleteButton {
    background-color: transparent;
    border: none;
    padding: 0;
}

QToolButton#keyDeleteButton:hover {
    background-color: transparent;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: $pressed;
}

QToolButton:disabled {
    color: $text_disabled;
}

/* ── Lists ── */
QListWidget,
QListView {
    background-color: $base;
    border: 1px solid $border;
    border-radius: 4px;
    color: $text;
    outline: none;
}

QListWidget::item,
QListView::item {
    padding: 3px 6px;
}

QListWidget::item:hover,
QListView::item:hover {
    background-color: $hover;
}

QListWidget::item:selected,
QListView::item:selected {
    background-color: $accent;
    color: $accent_text;
}

/* Plugin action grid (sidebar): icon tiles with the name underneath */
QListWidget#action-list {
    padding: 4px;
}

QListWidget#action-list::item {
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 2px;
    padding: 4px 2px;
}

QListWidget#action-list::item:hover {
    background-color: $hover;
    border-color: $border;
}

QListWidget#action-list::item:selected {
    background-color: $accent;
    border-color: $accent_line;
    color: $accent_text;
}

/* ── Menus ── */
QMenu {
    background-color: $surface;
    border: 1px solid $border;
    color: $text;
    padding: 4px;
}

QMenu::item {
    border-radius: 3px;
    padding: 4px 20px;
}

QMenu::item:selected {
    background-color: $accent;
    color: $accent_text;
}

QMenu::item:disabled {
    color: $text_disabled;
}

QMenu::separator {
    background-color: $border;
    height: 1px;
    margin: 4px 6px;
}

/* ── Tab widgets (settings dialog) ── */
QTabWidget::pane {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: $window;
    border: 1px solid $border;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: $text_muted;
    margin-right: 2px;
    padding: 5px 12px;
}

QTabBar::tab:selected {
    background-color: $surface;
    color: $text;
}

QTabBar::tab:hover:!selected {
    background-color: $hover;
    color: $text;
}

/* ── Page tabs (dashboard), styled like editor/browser tabs ── */
PageTabBar {
    background-color: $surface;
    border-bottom: 1px solid $border;
}

QTabBar#page-tabs {
    background: transparent;
}

QTabBar#page-tabs::tab {
    background-color: $surface;
    border: none;
    border-right: 1px solid $border;
    border-top: 2px solid transparent;
    border-radius: 0;
    color: $text_muted;
    margin: 0;
    padding: 6px 6px 6px 12px;
}

QTabBar#page-tabs::tab:selected {
    background-color: $window;
    border-top: 2px solid $accent_line;
    color: $text;
}

QTabBar#page-tabs::tab:hover:!selected {
    background-color: $hover;
    color: $text;
}

QToolButton#tab-close {
    border: none;
    border-radius: 3px;
    color: $text_muted;
    font-size: 11px;
    padding: 0;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

QToolButton#tab-close:hover {
    background-color: $hover;
    color: $text;
}

QLabel#default-page-marker {
    color: $accent_line;
    font-size: 10px;
    padding-left: 6px;
}

QToolButton#tab-add,
QToolButton#tab-scroll-left,
QToolButton#tab-scroll-right,
QToolButton#view-menu {
    border-radius: 0;
    color: $text_muted;
    font-size: 15px;
    padding: 2px 8px;
}

QToolButton#tab-add:hover,
QToolButton#tab-scroll-left:hover,
QToolButton#tab-scroll-right:hover,
QToolButton#view-menu:hover {
    background-color: $hover;
    color: $text;
}

QToolButton#view-menu::menu-indicator {
    image: none;
    width: 0;
}

/* ── Sidebar and splitters ── */
SidebarWidget {
    background-color: $surface;
    border-right: 1px solid $border;
}

QSplitter::handle {
    background-color: $window;
}

CardConfigPanel {
    border-top: 1px solid $border;
}

QSplitter::handle:hover {
    background-color: $accent_line;
}

/* ── Scroll bars ── */
QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle {
    background-color: $raised;
    border: 1px solid $border;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background-color: $hover;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* ── Key buttons ── */
KeyButtonWidget {
    background-color: $key_bg;
    border: 0.15em solid $key_border;
    border-radius: 2em;
    color: $key_text;
    font-size: 11px;
    font-weight: 500;
    padding: 0;
}

KeyButtonWidget:hover {
    background-color: $key_hover;
    border: 0.15em solid $accent_line;
}

KeyButtonWidget:pressed {
    background-color: $key_pressed;
}

/* ── Toast notification ── */
QLabel#toast {
    background-color: $toast_bg;
    border: 1px solid $error;
    border-radius: 4px;
    color: $toast_text;
    padding: 6px 10px;
}

/* ── Connecting overlay: always drawn over a dark tinted backdrop, so its colours are fixed ── */
QLabel#connecting-label {
    color: #f5f5f7;
    font-size: 15px;
    font-weight: 500;
    background: transparent;
}

QPushButton#connecting-settings-btn {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    color: #f5f5f7;
    font-size: 13px;
    padding: 6px 16px;
}

QPushButton#connecting-settings-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
}

QPushButton#connecting-settings-btn:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

/* ── Semantic label roles ── */
QLabel[role="title"] {
    color: $text;
    font-size: 13px;
    font-weight: bold;
}

QLabel[role="subtitle"] {
    color: $text_muted;
    font-size: 11px;
}

QLabel[role="body"] {
    color: $text;
    font-size: 14px;
}

QLabel[role="muted"] {
    color: $text_muted;
    font-size: 12px;
}

QLabel[role="success"] {
    color: $success;
    font-size: 12px;
}

QLabel[role="error"] {
    color: $error;
    font-size: 12px;
}

QLabel#keyPreview {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 4px;
}

QFrame[role="dock"] {
    border: 1px solid $border;
    border-radius: 4px;
    background: $base;
}

QToolButton[role="segment"] {
    border: 1px solid $border;
    border-radius: 0;
    background: $base;
    padding: 3px 6px;
    margin-left: -1px;
}

QToolButton[role="segment"]:hover {
    background: $hover;
}

QToolButton[role="segment"]:checked {
    background: $hover;
    border-color: $accent_line;
}

QToolButton[role="segment"][pos="first"] {
    margin-left: 0;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QToolButton[role="segment"][pos="last"] {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
